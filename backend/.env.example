# ─── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ────────────────────────────────────────────────
# MongoDB Atlas connection string (Required for Phase 2)
# Get from: https://cloud.mongodb.com → Connect → Drivers → Node.js
MONGODB_URI=

# ─── CORS ────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── JWT Authentication (Future Phase) ────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ─── Google Maps API (Future Phase) ───────────────────────────────
GOOGLE_MAPS_API_KEY=

# ─── Firebase (Future Phase) ─────────────────────
FIREBASE_PROJECT_ID=

# ─── Razorpay (Future Phase) ──────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── Cloudinary (Future Phase) ────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email Provider (Future Phase) ────────────────
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=

# ─── SMS Provider (Future Phase) ───────────────────────────
SMS_API_KEY=
